---
// The real-time arena card: lobby, the game canvas and the result. All of it is filled by src/scripts/play-live.ts,
// which loads src/lib/play/orb-rush.ts (an implementation of RealtimeArena, see arena-adapter.ts) only when needed.
import { copy } from "../content";
import { site } from "../site";
import type { Lang } from "../lib/i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang].play;
const a = c.arena;
const l = c.live;
---
<section class="glass play-panel arena-card" id="realtime-arena" aria-labelledby="arena-h" data-arena="orb-rush">
  <p class="eyebrow">{a.badge}</p>
  <h2 id="arena-h">{a.h2}</h2>
  <p>{a.text}</p>
  <p class="play-msg" id="play-lobby" role="status" aria-live="polite">{l.lobby.idle}</p>

  <div id="play-lobby-view" class="lobby-view" hidden>
    <h3 data-lv-title></h3>
    <p class="lobby-wait" data-lv-wait></p>
    <p data-lv-vs></p>
    <h4 data-lv-paid-h></h4>
    <ul class="seat-grid" data-lv-paid></ul>
    <h4 data-lv-free-h></h4>
    <ul class="seat-grid seat-grid-free" data-lv-free></ul>
    <div class="btn-row">
      <button type="button" class="btn btn-gold btn-lg" data-lv-fill hidden></button>
      <button type="button" class="btn btn-glass btn-lg" data-lv-practice></button>
      <button type="button" class="btn btn-glass btn-lg" data-tuto-open>{l.tutorial.open}</button>
    </div>
  </div>

  <div class="rotate-gate" data-rotate hidden role="dialog" aria-modal="true" aria-labelledby="rotate-h">
    <svg viewBox="0 0 64 64" width="72" height="72" aria-hidden="true"><rect x="22" y="8" width="20" height="36" rx="4" fill="none" stroke="currentColor" stroke-width="3"/><path d="M12 52c8 6 32 6 40 0M46 46l6 6-8 3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <h3 id="rotate-h">{l.game.rotateTitle}</h3>
    <p>{l.game.rotateText}</p>
    <button type="button" class="link-btn" data-rotate-stay>{l.game.rotateStay}</button>
  </div>

  <div class="tuto" data-tuto data-start={l.tutorial.start} data-step={l.tutorial.step} hidden role="dialog" aria-modal="true" aria-labelledby="tuto-title">
    <div class="tuto-card glass">
      <h3 id="tuto-title">{l.tutorial.title}</h3>
      <p class="muted small" data-tuto-step></p>
      <section class="tuto-slide" data-tuto-slide hidden={false}>
        <span class="tuto-icon"><svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" stroke-width="3" opacity=".5"/><circle cx="40" cy="26" r="11" fill="currentColor"/><path d="M12 52l12-12" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity=".5"/></svg></span>
        <h4>{l.tutorial.steps[0].h}</h4>
        <p class="touch-only">{l.tutorial.steps[0].touch}</p>
        <p class="desk-only">{l.tutorial.steps[0].desk}</p>
      </section>
      <section class="tuto-slide" data-tuto-slide hidden={true}>
        <span class="tuto-icon"><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M36 6L14 36h16l-4 22 24-32H34z" fill="currentColor"/></svg></span>
        <h4>{l.tutorial.steps[1].h}</h4>
        <p class="touch-only">{l.tutorial.steps[1].touch}</p>
        <p class="desk-only">{l.tutorial.steps[1].desk}</p>
      </section>
      <section class="tuto-slide" data-tuto-slide hidden={true}>
        <span class="tuto-icon"><svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="6 5"/><circle cx="32" cy="32" r="8" fill="currentColor"/><circle cx="46" cy="20" r="3" fill="currentColor" opacity=".7"/><circle cx="18" cy="42" r="3" fill="currentColor" opacity=".7"/></svg></span>
        <h4>{l.tutorial.steps[2].h}</h4>
        <p class="touch-only">{l.tutorial.steps[2].touch}</p>
        <p class="desk-only">{l.tutorial.steps[2].desk}</p>
      </section>
      <div class="btn-row">
        <button type="button" class="btn btn-glass btn-sm" data-tuto-back>{l.tutorial.back}</button>
        <button type="button" class="btn btn-gold" data-tuto-next>{l.tutorial.next}</button>
        <button type="button" class="btn btn-glass btn-sm" data-tuto-skip>{l.tutorial.skip}</button>
      </div>
    </div>
  </div>

  <div id="realtime-arena-host" class="game" hidden>
    <div class="game-hud">
      <p><span>{l.game.time}</span> <b data-hud-time>-</b></p>
      <p><span>{l.game.mass}</span> <b data-hud-mass>-</b></p>
      <p><span>{l.game.rank}</span> <b data-hud-rank>-</b></p>
      <p><span>{l.game.alive}</span> <b data-hud-alive>-</b></p>
      <p><span>{l.game.ping}</span> <b data-hud-ping>-</b></p>
      <p><span>{l.game.zone}</span> <b data-hud-zone>-</b></p>
      <button type="button" class="btn btn-glass btn-sm" data-boost-button aria-pressed="false">{l.game.boost}</button>
      <button type="button" class="btn btn-glass btn-sm touch-only" data-ctrl-toggle data-joy-label={l.game.ctrlJoystick} data-follow-label={l.game.ctrlFollow}>{l.game.ctrlJoystick}</button>
      <button type="button" class="btn btn-glass btn-sm" data-fs-toggle data-label-on={l.game.fullscreen} data-label-off={l.game.exitFullscreen} aria-pressed="false">{l.game.fullscreen}</button>
      <button type="button" class="btn btn-glass btn-sm" data-sound-toggle aria-pressed="false">{l.game.soundOff}</button>
      <label class="quality-pick"><span>{l.game.quality}</span>
        <select data-quality>
          <option value="auto">{l.game.qualityAuto}</option>
          <option value="high">{l.game.qualityHigh}</option>
          <option value="medium">{l.game.qualityMedium}</option>
          <option value="low">{l.game.qualityLow}</option>
        </select>
      </label>
      <button type="button" class="btn btn-glass btn-sm" data-diag-toggle aria-pressed="false">{l.game.diagButton}</button>
      <button type="button" class="btn btn-glass btn-sm" data-report-button>{l.game.reportButton}</button>
    </div>
    <p class="game-diag" data-diag hidden role="status" aria-live="off"></p>
    <p class="demo-note" data-report-note hidden role="status" aria-live="polite"></p>
    <textarea class="game-report" data-report-text hidden readonly rows="9" spellcheck="false" aria-label={l.game.reportButton}></textarea>
    <div class="game-board">
      <div class="game-canvas">
        <button type="button" class="fs-fab" data-fs-toggle data-label-on={l.game.fullscreen} data-label-off={l.game.exitFullscreen} aria-label={l.game.fullscreen} aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <p class="fs-hud" data-fs-hud aria-hidden="true"></p>
        <div class="joy" data-joy hidden aria-hidden="true"><span class="joy-knob" data-joy-knob></span></div>
        <button type="button" class="boost-fab touch-only" data-boost-button aria-label={l.game.boost} aria-pressed="false">{l.game.boost}</button>
        <canvas id="play-canvas" tabindex="0" role="img" aria-label={l.game.canvasLabel}></canvas>
        <p class="zone-banner" data-zone-banner hidden role="status"></p>
        <ul class="kill-feed" data-feed aria-hidden="true"></ul>
        <div class="game-loading" data-loading hidden role="status" aria-live="polite">
          <p class="game-loading-title" data-loading-title></p>
          <p class="game-loading-count" data-loading-count aria-hidden="true"></p>
          <p class="game-loading-hint">{l.arenaState.hint}</p>
        </div>
        <div class="dead-overlay" data-dead hidden>
          <div class="dead-head" data-dead-drag>
            <h3 data-dead-title></h3>
            <button type="button" class="dead-min" data-dead-min aria-expanded="true" aria-label="-">&minus;</button>
          </div>
          <p data-dead-text></p>
          <p data-dead-by></p>
          <p class="demo-note">{l.game.spectating}</p>
          <div class="btn-row">
            <button type="button" class="btn btn-glass btn-sm" data-spectate-map>{l.frenzy.spectateMap}</button>
            <button type="button" class="btn btn-glass btn-sm" data-spectate-next>{l.frenzy.spectateNext}</button>
            <button type="button" class="btn btn-glass btn-sm" data-spectate-free aria-pressed="false">{l.frenzy.spectateFree}</button>
          </div>
          <button type="button" class="btn btn-gold" data-dead-again hidden>{l.arenaState.practiceAgain}</button>
        </div>
      </div>
      <div class="game-side">
        <h3 class="sr">{l.game.scores}</h3>
        <ol class="sr" data-hud-scores></ol>
        <ul class="legend">
          <li><i class="lg-paid"></i>{l.game.paidLegend}</li>
          <li><i class="lg-sab"></i>{l.game.saboteurLegend}</li>
          <li><i class="lg-you"></i>{l.game.you}</li>
        </ul>
      </div>
    </div>
    <p class="demo-note">{l.game.controls}</p>
  </div>

  <div id="play-announce" class="sr" role="status" aria-live="polite" aria-atomic="true"></div>

  <div id="play-result" class="result" hidden tabindex="-1" aria-labelledby="play-result-h">
    <h3 id="play-result-h">{l.result.h2}</h3>
    <div id="play-result-body"></div>
    <button type="button" class="btn btn-glass btn-sm" id="play-result-close">{l.result.close}</button>
  </div>
</section>

---
import { site } from "../site";
import { copy } from "../content";
import { path, type Lang, type RouteKey } from "../lib/i18n";
import ShareBar from "./ShareBar.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = copy[lang].ui;
const cols: { h: string; keys: RouteKey[] }[] = [
  { h: ui.footer.play, keys: ["play", "profile", "games", "ideas", "how", "token"] },
  { h: ui.footer.trust, keys: ["security", "matches", "verify", "risks", "faq", "roadmap"] },
  { h: ui.footer.community, keys: ["opensource", "contribute", "replay", "invite", "support", "privacy", "terms"] },
];
const owner = site.legalName || site.name;
const isLab = site.lab;
const SOCIAL_LABEL: Record<string, string> = { x: "X", tiktok: "TikTok", telegram: "Telegram", github: "GitHub", instagram: "Instagram", youtube: "YouTube" };
const socials = Object.entries(site.social).filter(([, v]) => v);
---
<footer class="site-footer">
  {isLab ? (<div class="wrap"><p class="muted">Goshi Lab · <a href="https://goshi.app">goshi.app</a> · <a href="https://test.goshi.app">test.goshi.app</a></p></div>) : (<>
  <div class="wrap">
    <div class="foot">
      <div>
        <p class="brand"><span>Goshi</span></p>
        <p>{ui.footer.tagline}</p>
        {socials.length > 0 && <ul class="socials">{socials.map(([k, v]) => <li><a href={v} rel="noopener noreferrer me">{SOCIAL_LABEL[k] ?? k}</a></li>)}</ul>}
      </div>
      {cols.map((c) => (
        <nav aria-label={c.h}>
          <h2>{c.h}</h2>
          <ul>{c.keys.map((k) => <li><a href={path(lang, k)}>{ui.nav[k as keyof typeof ui.nav] ?? copy[lang].pages[k as Exclude<RouteKey, "home">].title}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <p class="foot-sites"><a href="https://test.goshi.app">{ui.nav.practiceSite}</a> · <a href="https://lab.goshi.app">{ui.nav.labSite}</a></p>
    <ShareBar lang={lang} />
    <div class="foot-bottom">
      <p><strong>{ui.footer.testNotice}</strong></p>
      <p>{ui.footer.notFinancial}</p>
      <p>© {site.year} {owner}. {ui.footer.rights} {ui.footer.noCookies} {ui.footer.trademarks}</p>
    </div>
  </div>
  </>)}
</footer>

---
// The Goshi mark: the neon G logo (brand/goshi-logo.jpg), prepared by scripts/make-brand-assets.mjs as /img/logo-*.png.
interface Props { size?: number; class?: string }
const { size = 38, class: cls } = Astro.props;
const src = size > 96 ? "/img/logo-384.png" : size > 48 ? "/img/logo-192.png" : "/img/logo-96.png";
---
<img class={cls} src={src} width={size} height={size} alt="" aria-hidden="true" decoding="async" />

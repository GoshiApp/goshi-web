---
// Every match played, newest first (the global history). The list and the cards are src/scripts/matches.ts and match-card.ts.
import { site } from "../site";
import { copy } from "../content";
import { path, type Lang } from "../lib/i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = copy[lang].matches;
const api = site.play.serverUrl.replace(/^wss:/, "https:").replace(/^ws:/, "http:");
const data = JSON.stringify({
  api, rpc: site.play.rpcUrl ?? "https://api.devnet.solana.com", cluster: site.play.cluster,
  t: copy[lang].verify, r: copy[lang].replay, m, verifyHref: path(lang, "verify"),
  domain: site.domain, ca: site.play.cluster === "mainnet-beta" ? site.play.goshiMint : "",
});
---
<section class="section" id="matches">
  <div class="wrap">
    <form class="matches-search" id="matches-search" novalidate>
      <input id="matches-q" type="text" autocomplete="off" spellcheck="false" aria-label={copy[lang].verify.label} placeholder={copy[lang].verify.placeholder} />
      <button class="btn btn-gold btn-sm" type="submit">{copy[lang].verify.button}</button>
      <button class="btn btn-glass btn-sm" type="button" id="matches-clear" hidden>{m.filterAll}</button>
    </form>
    <div class="matches-bar">
      <div class="chips" role="group" aria-label={m.filterLabel} id="matches-filter">
        <button type="button" class="chip on" data-mode="">{m.filterAll}</button>
        <button type="button" class="chip" data-mode="royale">{m.modes.royale}</button>
        <button type="button" class="chip" data-mode="vs">{m.modes.vs}</button>
        <button type="button" class="chip" data-mode="duel">{m.modes.duel}</button>
      </div>
      <button type="button" class="btn btn-gold btn-sm" id="matches-tv">{m.tvStart}</button>
      <button type="button" class="btn btn-glass btn-sm" id="matches-refresh">{m.refresh}</button>
    </div>
    <p class="muted" id="matches-msg" role="status" aria-live="polite">{m.loading}</p>
    <ul class="idea-list" id="matches-list"></ul>
    <div class="btn-row"><button type="button" class="btn btn-glass" id="matches-more" hidden>{m.loadMore}</button></div>
    {site.lobby && (
      <section class="season-board" id="season-board" data-api={api} data-t={JSON.stringify(m.season)} aria-labelledby="season-h">
        <h3 id="season-h" data-season-title>{m.season.title}</h3>
        <p class="muted" data-season-sub></p>
        <ol class="season-list" data-season-list></ol>
      </section>
    )}
    {site.lobby && (
      <div class="var-board" id="var-board" data-api={api} data-t={JSON.stringify(m.var)}>
        <h2>{m.var.h2}</h2>
        <p class="muted var-intro">{m.var.intro}</p>
        <div class="var-stage glass">
          <div class="var-head">
            <div>
              <p class="var-title" id="var-title">{m.var.pick}</p>
              <p class="var-sub" id="var-sub"></p>
            </div>
            <span class="var-badge" id="var-badge" hidden></span>
          </div>
          <div class="var-screen"><canvas id="var-canvas" width="1280" height="720"></canvas></div>
          <div class="var-controls" id="var-controls" hidden>
            <button type="button" class="btn btn-glass btn-sm var-pp" id="var-playpause" aria-label={m.var.playPause}></button>
            <input type="range" id="var-seek" class="var-seek" aria-label={m.var.seek} />
            <select id="var-speed" class="var-speed" aria-label={m.var.speed}><option value="0.5">0.5x</option><option value="1">1x</option><option value="2">2x</option><option value="4">4x</option></select>
            <span class="var-clock" id="var-clock"></span>
          </div>
          <div class="var-actions" id="var-actions" hidden>
            <button type="button" class="btn btn-gold btn-sm" id="var-share">{m.var.share}</button>
            <button type="button" class="btn btn-glass btn-sm" id="var-video">{m.var.video}</button>
            <a class="btn btn-glass btn-sm" id="var-pay" target="_blank" rel="noopener noreferrer" hidden></a>
            <a class="btn btn-glass btn-sm" id="var-x" target="_blank" rel="noopener noreferrer">{m.var.shareX}</a>
            <span class="muted" id="var-msg" role="status" aria-live="polite"></span>
          </div>
        </div>
        <div class="chips var-tabs" role="tablist">
          <button type="button" class="chip on" data-var-tab="mine">{m.var.history}</button>
          <button type="button" class="chip" data-var-tab="cashout">{m.var.cashouts}</button>
          <button type="button" class="chip" data-var-tab="all">{m.var.all}</button>
        </div>
        <ul class="var-grid" id="var-list"></ul>
        <p class="muted" id="var-empty" hidden></p>
      </div>
    )}
    <script type="application/json" id="matches-data" set:html={data}></script>
  </div>
</section>
<script>import "../scripts/matches.ts";
import "../scripts/var-board.ts";
import "../scripts/season-board.ts";</script>

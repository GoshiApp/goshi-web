---
import { copy } from "../content";
import { site } from "../site";
import { path, type Lang } from "../lib/i18n";
import Icon from "./Icon.astro";
import { arenaScene } from "../lib/scene";
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = copy[lang].home.hero;
// Deterministic star field (no randomness at build, so builds are reproducible).
let seed = 11;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const stars = Array.from({ length: 90 }, (_, i) => ({
  x: +(rnd() * 100).toFixed(2), y: +(rnd() * 100).toFixed(2),
  r: +(0.6 + rnd() * 1.2).toFixed(2), o: +(0.35 + rnd() * 0.65).toFixed(2), tw: i % 3 !== 0,
}));
const trustIcons = ["flask", "code", "scale"];
const playHref = path(lang, "play");
const unit = copy[lang].play.units.sol;
const quickDefaults = [1, 2.5];
---
<div class="wrap hero-wrap">
  <section class="sky" aria-labelledby="hero-title">
    <svg class="stars" width="100%" height="100%" aria-hidden="true">
      {stars.map((s) => <circle class={s.tw ? "tw" : ""} cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} opacity={s.o} />)}
    </svg>
    <div class="hero">
      <div>
        <p class="eyebrow">{h.eyebrow}</p>
        <h1 id="hero-title">{h.h1}</h1>
        <p class="lead">{h.sub}</p>
        <div class="btn-row">
          {site.play.enabled
            ? <a class="btn btn-gold" href={`${path(lang, "play")}?play=1`} data-practice-cta>{h.practice}</a>
            : <a class="btn btn-gold" href={path(lang, "play")}>{h.primary}</a>}
          <a class="btn btn-glass" href={path(lang, "how")}>{h.secondary}</a>
        </div>
        {site.play.enabled && (
          <div class="hero-quick" data-quick-hero data-server={site.play.serverUrl} data-about={h.quickAbout} data-unit={unit} data-play={playHref} data-aria={h.quickAria}>
            <p class="hero-quick-h">{h.quickH}</p>
            <div class="hero-quick-row">
              {quickDefaults.map((usd) => (
                <a class="quick-btn" href={`${playHref}?quick=${usd}`} data-usd={usd} aria-label={h.quickAria.replace("{usd}", `$${usd}`)}>
                  <strong>${usd}</strong><small data-sol>{h.quickLoading}</small>
                </a>
              ))}
            </div>
            <p class="table-note">{h.quickNote}</p>
          </div>
        )}
        <ul class="trust">
          {h.trust.map((x, i) => <li><Icon name={trustIcons[i] ?? "check"} />{x}</li>)}
        </ul>
      </div>
      <div class="stage">
        <div class="hero-scene" role="img" aria-label={h.illustrationAlt} set:html={arenaScene({ w: 640, h: 480, lang })}></div>
        <div class="float f1" role="note"><b>{h.f1.label}</b>{h.f1.text}</div>
        <div class="float f2" role="note"><b>{h.f2.label}</b>{h.f2.text}</div>
        <div class="float f3" role="note"><b>{h.f3.label}</b>{h.f3.text}</div>
      </div>
    </div>
  </section>
  <p class="table-note" style="text-align:center">{h.example}</p>
</div>
{site.play.enabled && <script>import "../scripts/home-quick.ts";</script>}

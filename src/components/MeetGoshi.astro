---
// "Meet the goshi": the creature drawn in SVG with three short lines.
import { copy } from "../content";
import type { Lang } from "../lib/i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = copy[lang].home.meet;
---
<section class="wrap meet" aria-labelledby="meet-h">
  <svg class="meet-art" viewBox="0 0 160 140" role="img" aria-label={m.alt}>
    <defs>
      <radialGradient id="meet-body" cx="38%" cy="30%" r="75%"><stop offset="0" stop-color="#ffe08a" /><stop offset="0.55" stop-color="#f2c94c" /><stop offset="1" stop-color="#e0a92a" /></radialGradient>
    </defs>
    <path d="M104 98C132 104 148 80 138 52" fill="none" stroke="#f2c94c" stroke-width="14" stroke-linecap="round" />
    <circle cx="72" cy="72" r="52" fill="url(#meet-body)" />
    <circle cx="54" cy="66" r="15" fill="#ffffff" />
    <circle cx="90" cy="66" r="15" fill="#ffffff" />
    <circle cx="57" cy="69" r="8" fill="#0c1334" />
    <circle cx="93" cy="69" r="8" fill="#0c1334" />
    <circle cx="60" cy="66" r="3" fill="#ffffff" />
    <circle cx="96" cy="66" r="3" fill="#ffffff" />
    <ellipse cx="36" cy="92" rx="9" ry="5.5" fill="#ff8fa3" opacity="0.75" />
    <ellipse cx="108" cy="92" rx="9" ry="5.5" fill="#ff8fa3" opacity="0.75" />
    <path d="M64 96Q72 106 80 96" fill="none" stroke="#0c1334" stroke-width="3.5" stroke-linecap="round" />
    <circle cx="140" cy="16" r="8" fill="#7be3c3" />
    <circle cx="20" cy="22" r="5" fill="#8ab4ff" />
  </svg>
  <div class="meet-text">
    <h2 id="meet-h">{m.h2}</h2>
    <ul>{m.lines.map((l) => <li>{l}</li>)}</ul>
  </div>
</section>

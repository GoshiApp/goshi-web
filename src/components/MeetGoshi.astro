---
// "Meet the goshi": the creature drawn in SVG with three short lines.
import { copy } from "../content";
import type { Lang } from "../lib/i18n";
import { goshiHeadSvg } from "../lib/scene";
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = copy[lang].home.meet;
---
<section class="wrap meet" aria-labelledby="meet-h">
  <div class="meet-art" role="img" aria-label={m.alt} set:html={goshiHeadSvg(48)}></div>
  <div class="meet-text">
    <h2 id="meet-h">{m.h2}</h2>
    <ul>{m.lines.map((l) => <li>{l}</li>)}</ul>
  </div>
</section>

---
// A plain illustration of the arena rules (not a recording). Honest: it matches the rules of the game server.
import { copy } from "../content";
import type { Lang } from "../lib/i18n";
import { arenaScene } from "../lib/scene";
interface Props { lang: Lang }
const { lang } = Astro.props;
const o = copy[lang].orb;
const orbs = [[70, 60, 5, "#7be3c3"], [330, 70, 7, "#8ab4ff"], [60, 250, 7, "#f2c94c"], [345, 235, 5, "#7be3c3"], [190, 40, 5, "#8ab4ff"], [250, 150, 4, "#7be3c3"], [110, 150, 4, "#f2c94c"]] as const;
// Bodies as chains of circles (the last point is the head).
const mine = [[70, 190], [90, 198], [112, 202], [134, 200], [156, 194]] as const;
const other = [[300, 80], [280, 100], [262, 124], [248, 150], [244, 176]] as const;
---
<figure class="glass figure-box orb-fig">
  <div class="orb-scene" role="img" aria-label={o.alt} set:html={arenaScene({ w: 640, h: 480, lang })}></div>
  <figcaption>{o.caption}</figcaption>
</figure>

{
  "name": "goshi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:play": "PUBLIC_PLAY_LOCAL=1 astro dev",
    "play:local-config": "node scripts/play-local-config.mjs",
    "build": "node scripts/build-standalone.mjs && astro build && node scripts/prune-play.mjs && node scripts/check-dist.mjs",
    "build:only": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test src/lib/play/*.test.ts",
    "gates": "node scripts/check-dist.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "contrast": "node scripts/contrast.mjs",
    "verify": "npm run check && npm run test && npm run build && npm run contrast"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "astro": "^7.3.5",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/nunito": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.6"
  },
  "overrides": {
    "bigint-buffer": "npm:@trufflesuite/bigint-buffer@1.1.10",
    "uuid": "^11.1.1"
  }
}
